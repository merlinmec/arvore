# Copie para .env (git-ignorado) e preencha. Use aspas simples: o hash bcrypt tem "$",
# que sem aspas o Docker Compose tentaria interpretar como variável.

ARVORE_USUARIO=joao
# gere com: htpasswd -bnBC 10 "" "sua-senha" | tr -d ':\n' | sed 's/^\$2y/\$2a/'
ARVORE_SENHA_HASH=''
# pelo menos 32 caracteres aleatórios
ARVORE_JWT_SEGREDO=''

# opcionais
# POSTGRES_PASSWORD=arvore
# PORTA=8000

# só para rodar sempre ligado no próprio computador (docker-compose.local.yml, ver docs/DEPLOY.md)
# BACKUP_DIR=C:/Users/voce/OneDrive/arvore-backups
# BACKUP_KEEP_DAYS=30
